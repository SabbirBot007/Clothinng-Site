// ============================================================
// schema.prisma — Clothing Store
// Database: PostgreSQL (Supabase)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// AUTH — Required by next-auth + @next-auth/prisma-adapter
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// USER
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Auth relations (required by next-auth)
  accounts Account[]
  sessions Session[]

  // Store relations
  orders   Order[]
  reviews  Review[]
  wishlist Wishlist[]
  cart     CartItem[]

  @@index([email])
}

// ============================================================
// CATEGORY
// ============================================================

model Category {
  id          String    @id @default(cuid())
  name        String    @unique // e.g. "T-Shirts", "Jackets", "Dresses"
  slug        String    @unique // e.g. "t-shirts", "jackets"
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]

  @@index([slug])
}

// ============================================================
// PRODUCT
// ============================================================

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique // URL-friendly name, e.g. "classic-white-tee"
  description String   @db.Text
  price       Decimal  @db.Decimal(10, 2) // Base price
  categoryId  String
  brand       String?
  material    String?  // e.g. "100% Cotton"
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category  Category         @relation(fields: [categoryId], references: [id])
  images    ProductImage[]
  variants  ProductVariant[]
  reviews   Review[]
  wishlist  Wishlist[]
  cartItems CartItem[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([slug])
  @@index([isActive, isFeatured])
}

// ============================================================
// PRODUCT IMAGES (multiple per product)
// ============================================================

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String   // Cloudinary URL
  publicId  String   // Cloudinary public_id (needed for deletion)
  altText   String?
  position  Int      @default(0) // Order of display, 0 = primary/cover image
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ============================================================
// PRODUCT VARIANTS (size + color combinations)
// Each variant = one specific size + color combo with its own stock
// Example: "Red / XL" = 1 variant row
// ============================================================

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  size      Size
  color     String   // e.g. "Red", "Navy Blue", "White"
  colorHex  String?  // e.g. "#FF0000" for color swatch display
  stock     Int      @default(0)
  sku       String?  @unique // Stock Keeping Unit, optional but useful
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size, color]) // Can't have duplicate size+color per product
  @@index([productId])
}

// Standard clothing sizes
enum Size {
  XS
  S
  M
  L
  XL
  XXL
  XXXL
}

// ============================================================
// CART
// Persisted in DB so cart survives browser close / device switch
// ============================================================

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  variantId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId]) // One row per variant per user, quantity handles multiples
  @@index([userId])
}

// ============================================================
// WISHLIST
// ============================================================

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId]) // Can't wishlist the same product twice
  @@index([userId])
}

// ============================================================
// ORDER
// ============================================================

model Order {
  id              String      @id @default(cuid())
  userId          String
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @db.Decimal(10, 2)
  shippingCost    Decimal     @db.Decimal(10, 2) @default(0)
  total           Decimal     @db.Decimal(10, 2)

  // Stripe
  stripePaymentId String?     @unique
  paidAt          DateTime?

  // Shipping address (stored directly — not a separate table for local-only)
  shippingName    String
  shippingPhone   String
  shippingAddress String
  shippingCity    String
  shippingZip     String

  // Timestamps
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum OrderStatus {
  PENDING       // Payment initiated but not confirmed
  PAID          // Payment confirmed by Stripe
  PROCESSING    // Admin confirmed, preparing to ship
  SHIPPED       // Dispatched, tracking available
  DELIVERED     // Confirmed delivered
  CANCELLED     // Cancelled by user or admin
  REFUNDED      // Refund issued
}

// ============================================================
// ORDER ITEMS — snapshot of product at time of purchase
// We store name/price directly so historical orders stay accurate
// even if the product price changes later
// ============================================================

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  variantId   String
  productName String  // Snapshot
  size        Size    // Snapshot
  color       String  // Snapshot
  price       Decimal @db.Decimal(10, 2) // Price at time of purchase
  quantity    Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

// ============================================================
// REVIEWS
// ============================================================

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int      // 1–5
  title     String?
  body      String?  @db.Text
  isVisible Boolean  @default(true) // Admin can hide inappropriate reviews
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId]) // One review per product per user
  @@index([productId])
  @@index([rating])
}
